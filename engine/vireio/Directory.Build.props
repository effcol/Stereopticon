<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Enables vcpkg manifest mode for every vcxproj under this directory.
    Picks up Vireio Perception's vcpkg.json (sibling of this file) to install
    directxtex, directxtk, directxmath, glew, glfw3, nlohmann-json on build.
  -->
  <PropertyGroup>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgEnabled>true</VcpkgEnabled>
    <VcpkgManifestInstall>true</VcpkgManifestInstall>
    <VcpkgUseStatic>false</VcpkgUseStatic>
    <VcpkgConfiguration Condition="'$(Configuration)' == 'Release' or '$(Configuration)' == 'Developer'">Release</VcpkgConfiguration>
    <VcpkgConfiguration Condition="'$(Configuration)' == 'Debug'">Debug</VcpkgConfiguration>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <VcpkgTriplet>x64-windows</VcpkgTriplet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'Win32'">
    <VcpkgTriplet>x86-windows</VcpkgTriplet>
  </PropertyGroup>
</Project>
